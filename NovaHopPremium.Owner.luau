	'-- NovaHop rejoin guard: runs first in every server, before NovaHop or any key system loads.\n-- If NovaHop was running and ANY error / kick screen shows up (Roblox errors, key system kicks like "JUNKIE J2_131"),\n-- it leaves and keeps trying servers until one works. Once NovaHop is loaded it hands the job to NovaHop\'s own rescue.\nlocal g = getgenv()\nif g._nhguard == game.JobId then return end\ng._nhguard = game.JobId\nlocal Players, TP, GS = game:GetService("Players"), game:GetService("TeleportService"), game:GetService("GuiService")\nrepeat task.wait() until Players.LocalPlayer\nlocal lp = Players.LocalPlayer\nlocal runfile = "NovaHop/" .. lp.UserId .. ".run"\nlocal function running()\n\tlocal ok, t = pcall(function() return tonumber(readfile(runfile)) end)\n\treturn ok and t ~= nil and os.time() - t < 900\nend\nlocal fired = false\nlocal function rejoin(why)\n\tif fired or not running() then return end\n\tif g._nhrescue and g._nhrescue(why) then return end   -- NovaHop is loaded and running: it handles it\n\tfired = true\n\twarn("[NovaHop] " .. tostring(why) .. ", rejoining")\n\tpcall(writefile, runfile, tostring(os.time()))\n\tpcall(writefile, "NovaHop/" .. lp.UserId .. ".rescue", tostring(os.time()))   -- next server: press Start again\n\tlocal q = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or queueonteleport\n\tif q then pcall(q, \'loadstring(readfile("NovaHop/boot.lua"))()\') end\n\ttask.spawn(function()\n\t\tlocal n = 0\n\t\twhile true do\n\t\t\tn += 1\n\t\t\tpcall(TP.TeleportCancel, TP)\n\t\t\tpcall(function() TP:Teleport(game.PlaceId, lp) end)\n\t\t\ttask.wait(n < 5 and 10 or 20)\n\t\tend\n\tend)\nend\nGS.ErrorMessageChanged:Connect(function(m) if m and m ~= "" then rejoin(m) end end)\nlocal function badtext(t)\n\tt = tostring(t or "")\n\treturn t:lower():find("junkie", 1, true) ~= nil or t:match("^%s*%a%d+_%d+%s*$") ~= nil\nend\nlocal function shown(x)   -- only a popup that is really on screen with an error text counts (Roblox keeps a hidden one ready)\n\tif typeof(x) ~= "Instance" or not x:IsA("GuiObject") then return false end   -- skip the ErrorPrompt ModuleScript in RobloxGui.Modules\n\tfor _ = 1, 6 do\n\t\ttask.wait(0.5)\n\t\tif not x.Parent then return false end\n\t\tlocal vis, a = true, x\n\t\twhile a and a:IsA("GuiObject") do if not a.Visible then vis = false break end a = a.Parent end\n\t\tif vis and x.AbsoluteSize.X > 0 then\n\t\t\tfor _, d in ipairs(x:GetDescendants()) do\n\t\t\t\tif d:IsA("TextLabel") and d.Visible and #tostring(d.Text):gsub("%s", "") > 3 and d.Name ~= "ErrorTitle" then return true, d.Text end\n\t\t\tend\n\t\tend\n\tend\n\treturn false\nend\nlocal function check(x)   -- a "Leave" button next to a key-system error ("JUNKIE" / "J2_131"), or Roblox\'s own error prompt\n\tif x.Name == "ErrorPrompt" then local ok, t = shown(x) if ok then rejoin(t) end return end\n\tif not (x:IsA("TextButton") or x:IsA("TextLabel")) then return end\n\ttask.wait(0.3)\n\tif not x.Parent or tostring(x.Text):lower():gsub("%s", "") ~= "leave" then return end\n\tlocal box = x\n\tfor _ = 1, 5 do\n\t\tbox = box.Parent\n\t\tif not box or box:IsA("LayerCollector") and box.Parent == nil then break end\n\t\tfor _, d in ipairs(box:GetDescendants()) do\n\t\t\tif (d:IsA("TextLabel") or d:IsA("TextButton")) and badtext(d.Text) then rejoin("key system kick (" .. tostring(d.Text):sub(1, 20) .. ")") return end\n\t\tend\n\t\tif box:IsA("LayerCollector") then break end\n\tend\nend\nlocal function watch(root)\n\tif not root then return end\n\troot.DescendantAdded:Connect(function(x) task.spawn(pcall, check, x) end)   -- pcall: an odd popup can never crash the guard\n\tfor _, x in ipairs(root:GetDescendants()) do task.spawn(pcall, check, x) end\nend\npcall(function() watch(game:GetService("CoreGui")) end)\npcall(function() if gethui then watch(gethui()) end end)\npcall(function() watch(lp:WaitForChild("PlayerGui", 20)) end)\ntask.spawn(function()   -- in case a signal was missed\n\twhile not fired do\n\t\ttask.wait(3)\n\t\tlocal ok, m = pcall(function() return GS:GetErrorMessage() end)\n\t\tif ok and m and m ~= "" then rejoin(m) end\n\tend\nend)\n',
