-- TifaHop: executable Luau reconstruction.
-- Edit UserConfig below to change startup defaults.
-- Recovered source; requires the original Roblox/executor APIs and files.
-- Compilation and isolated control-flow tests do not validate live game behavior.
local env = getfenv()
local pack = table.pack
local unpack = table.unpack
local Functions = {}

-- Public loader settings; remaining settings keep their recovered defaults.
local shared = (getgenv and getgenv()) or env
local options = ...
local players = game:GetService("Players")
if not game:IsLoaded() then game.Loaded:Wait() end
while not players.LocalPlayer do task.wait() end
local player = players.LocalPlayer
local configPath = "TifaHop/loader_" .. tostring(player.UserId) .. ".json"
local http = game:GetService("HttpService")

if options == nil then options = shared.TifaHop end
if options == nil and readfile and isfile and isfile(configPath) then
  local ok, saved = pcall(function() return http:JSONDecode(readfile(configPath)) end)
  if ok and type(saved) == "table" then options = saved end
end
if options == nil then options = {} end
assert(type(options) == "table", "TifaHop configuration must be a table")
local allowed = {MinViciousLevel=true, MaxViciousLevel=true, DontHop=true, MainAccount=true, Group=true, ViciousMovement=true}
for key in pairs(options) do assert(allowed[key], "Unknown TifaHop setting: " .. tostring(key)) end
local function level(key, fallback)
  local value = options[key]
  if value == nil then return fallback end
  assert(type(value) == "number" and value % 1 == 0 and value >= 1 and value <= 12,
    key .. " must be an integer from 1 to 12")
  return value
end
local minLevel, maxLevel = level("MinViciousLevel",1), level("MaxViciousLevel",12)
assert(minLevel <= maxLevel, "MinViciousLevel must not exceed MaxViciousLevel")
local dontHop = options.DontHop
if dontHop == nil then dontHop = false end
assert(type(dontHop)=="boolean", "DontHop must be true or false")
local viciousMovement = options.ViciousMovement
if viciousMovement == nil then viciousMovement = "Walk" end
assert(viciousMovement=="Walk" or viciousMovement=="Tween", "ViciousMovement must be Walk or Tween")
local mainAccount = options.MainAccount or ""
local group = options.Group or ""
assert(type(mainAccount)=="string", "MainAccount must be a Roblox username, or an empty string")
assert(type(group)=="string", "Group must be a shared room name, or an empty string")
mainAccount = mainAccount:match("^%s*(.-)%s*$")
group = group:match("^%s*(.-)%s*$")
local grouped = group ~= ""
assert(not grouped or mainAccount ~= "", "Set MainAccount when using a Group")
local isMain = grouped and player.Name:lower() == mainAccount:lower()
local UserConfig = {
  mode="vichop", minlvl=minLevel, maxlvl=maxLevel, donthop=dontHop,
  room=group, main=isMain, alt=grouped and not isMain,
}
shared.TifaHop = {
  MinViciousLevel=minLevel, MaxViciousLevel=maxLevel, DontHop=dontHop,
  MainAccount=mainAccount, Group=group,
  ViciousMovement=viciousMovement,
}
-- Original native overrides are applied after saved settings. Supplying these
-- makes the loader settings authoritative during startup without polling.
for key,value in pairs(UserConfig) do shared[key]=value end
shared.mainuser = grouped and mainAccount or ""
if writefile and makefolder and isfolder then
  local ok, reason = pcall(function()
    if not isfolder("TifaHop") then makefolder("TifaHop") end
    writefile(configPath, http:JSONEncode(shared.TifaHop))
  end)
  if not ok then warn("[TifaHop] Could not save loader configuration: " .. tostring(reason)) end
end
local function applyUserConfig(settings)
  for key,value in pairs(UserConfig) do settings[key]=value end
end

-- Some original branding is assembled from multiple string fragments.
-- Apply renaming after concatenation as well as to recovered constants.
local function rebrandString(value)
  if type(value) ~= "string" then return value end
  if value:find("https://novahop-relay.",1,true) then return value end
  value=value:gsub("NovaHop","TifaHop"):gsub("novahop","tifahop"):gsub("NOVAHOP","TIFAHOP")
  value=value:gsub("_nh","_th")
  return value
end

-- Ground navigation used only for the approach to a Vicious Bee.
-- Combat positioning and the original movement routines remain separate.
local function walkToVicious(target, isRunning, setStatus)
  local character = player.Character
  local humanoid = character and character:FindFirstChildOfClass("Humanoid")
  local root = character and character:FindFirstChild("HumanoidRootPart")
  local monsterRoot = target and target:FindFirstChild("HumanoidRootPart")
  local monsterHumanoid = target and target:FindFirstChildOfClass("Humanoid")
  if not humanoid or not root or not monsterRoot then return false end
  local function active()
    return isRunning() and player.Character == character and character.Parent ~= nil
      and root.Parent ~= nil and humanoid.Health > 0
      and target.Parent ~= nil and monsterRoot.Parent ~= nil
      and (not monsterHumanoid or monsterHumanoid.Health > 0)
  end
  local function nearTarget()
    return (root.Position - monsterRoot.Position).Magnitude <= 12
  end
  local function stop()
    if root.Parent and humanoid.Health > 0 then humanoid:MoveTo(root.Position) end
  end
  local function finish(connection)
    if connection then connection:Disconnect() end
    stop()
    return false
  end
  if not active() then return false end
  if nearTarget() then return true end
  setStatus("Walking to Vicious Bee")
  local pathfinding = game:GetService("PathfindingService")
  local heartbeat = game:GetService("RunService").Heartbeat
  local rayParams = RaycastParams.new()
  rayParams.FilterType = Enum.RaycastFilterType.Exclude
  rayParams.FilterDescendantsInstances = {character, target}
  local deadline = os.clock() + 90
  local failures = 0

  while active() and os.clock() < deadline and failures < 5 do
    if nearTarget() then stop(); return true end
    local plannedTarget = monsterRoot.Position
    local hit = workspace:Raycast(plannedTarget + Vector3.new(0,4,0), Vector3.new(0,-40,0), rayParams)
    local destination = hit and hit.Position + Vector3.new(0,3,0) or plannedTarget
    local path = pathfinding:CreatePath({
      AgentRadius=2, AgentHeight=5, AgentCanJump=true,
      AgentCanClimb=true, WaypointSpacing=4,
    })
    local ok = pcall(function() path:ComputeAsync(root.Position,destination) end)
    if not active() then stop(); return false end
    if not ok or path.Status ~= Enum.PathStatus.Success then
      failures += 1
      task.wait(0.4)
    else
      local blocked, currentIndex = false, 1
      local blockedConnection = path.Blocked:Connect(function(index)
        if index >= currentIndex then blocked = true end
      end)
      local repath, movedTarget = false, false
      for index,waypoint in ipairs(path:GetWaypoints()) do
        currentIndex = index
        if not active() then return finish(blockedConnection) end
        if nearTarget() then blockedConnection:Disconnect(); stop(); return true end
        if blocked then repath=true; break end
        if (waypoint.Position-root.Position).Magnitude > 3 then
          if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump=true end
          local ended, reached = false, false
          local moveConnection = humanoid.MoveToFinished:Connect(function(didReach)
            ended, reached = true, didReach
          end)
          local started = os.clock()
          local bestDistance = (waypoint.Position-root.Position).Magnitude
          local lastProgress = started
          local timeout = math.clamp(bestDistance / math.max(humanoid.WalkSpeed,1)*2+2,3,10)
          humanoid:MoveTo(waypoint.Position)
          while active() and not ended and not blocked and os.clock() < deadline do
            local distance = (waypoint.Position-root.Position).Magnitude
            if distance <= 3 then reached=true; break end
            if nearTarget() then reached=true; break end
            if (monsterRoot.Position-plannedTarget).Magnitude > 8 then
              movedTarget=true; break
            end
            local now = os.clock()
            if distance < bestDistance-0.5 then bestDistance=distance; lastProgress=now end
            if now-started > timeout or now-lastProgress > 3 then break end
            heartbeat:Wait()
          end
          moveConnection:Disconnect()
          if not active() then return finish(blockedConnection) end
          if blocked or movedTarget or not reached then repath=true; break end
        end
      end
      blockedConnection:Disconnect()
      if nearTarget() then stop(); return true end
      -- A moving target needs a fresh route; fixed obstructions consume retries.
      if not movedTarget then failures += 1 end
      if repath then setStatus("Replanning path to Vicious Bee") end
      task.wait(0.1)
    end
  end
  stop()
  if active() then
    setStatus("Cannot reach Vicious Bee by walking")
    warn("[TifaHop] No walkable route to Vicious Bee; flying fallback is disabled")
  end
  return false
end


