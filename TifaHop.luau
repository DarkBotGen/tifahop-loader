-- Local startup: the license-screen module and its callbacks are not included.
Functions.entry = function(_upvalues, ...)
  local state = (getgenv and getgenv()) or env
  if state._thjob == game.JobId then return end

  -- Remove the old prompt if a preceding build already displayed it.
  local function removeOldPrompt(root)
    if not root then return end
    local prompt = root:FindFirstChild("NovaKey")
    if prompt and prompt:IsA("ScreenGui") then prompt:Destroy() end
  end
  pcall(function() removeOldPrompt(game:GetService("CoreGui")) end)
  pcall(function() removeOldPrompt(player:FindFirstChild("PlayerGui")) end)
  if gethui then pcall(function() removeOldPrompt(gethui()) end) end

  state._thjob = game.JobId
  state._thstarting = true
  pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
      Title = "TifaHop", Text = "Starting...", Duration = 3,
    })
  end)
  local ok, reason = xpcall(function()
    return Functions.initialize_automation({})
  end, function(message)
    return tostring(message) .. "\n" .. debug.traceback()
  end)
  state._thstarting = nil
  if not ok then
    state._thjob = nil -- allow retry after a failed initialization
    Functions.report_error({}, reason)
  end
end


return Functions.entry({}, ...)
