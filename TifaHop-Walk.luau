local env = getfenv()
local pack = table.pack
local unpack = table.unpack
local Functions = {}
local shared = (getgenv and getgenv()) or env
local options = ...
local players = game:GetService("Players")
if not game:IsLoaded() then game.Loaded:Wait() end
while not players.LocalPlayer do task.wait() end
local player = players.LocalPlayer
local configPath = "TifaHop/loader_" .. tostring(player.UserId) .. ".json"
local http = game:GetService("HttpService")
local farmPath="TifaHop/farm_"..tostring(player.UserId)..".txt"
local function validFarmSelection(value)
return value=="vichop" or value=="sprouts" or value=="windy" or value=="mondo"
end
local selectedFarm=shared.TifaHopSelectedFarm
if not validFarmSelection(selectedFarm) and readfile and isfile and isfile(farmPath) then
local ok,value=pcall(readfile,farmPath)
if ok and validFarmSelection(value) then selectedFarm=value end
end
if not validFarmSelection(selectedFarm) then selectedFarm=nil end
local function rememberFarmSelection(value)
if not validFarmSelection(value) then return end
selectedFarm=value
shared.TifaHopSelectedFarm=value
if writefile then
local ok,reason=pcall(writefile,farmPath,value)
if not ok then warn("[TifaHop] Could not save selected farm: "..tostring(reason)) end
end
end
if options == nil then options = shared.TifaHop end
if options == nil and readfile and isfile and isfile(configPath) then
local ok, saved = pcall(function() return http:JSONDecode(readfile(configPath)) end)
if ok and type(saved) == "table" then options = saved end
end
if options == nil then options = {} end
assert(type(options) == "table", "TifaHop configuration must be a table")
local allowed = {RelayURL=true,MinViciousLevel=true, MaxViciousLevel=true, DontHop=true, MainAccount=true, Group=true, ViciousMovement=true, Mode=true, TweenSpeed=true, UseRedCannon=true, WalkSpeedEnabled=true, WalkSpeed=true}
for key in pairs(options) do assert(allowed[key], "Unknown TifaHop setting: " .. tostring(key)) end
local function level(key, fallback)
local value = options[key]
if value == nil then return fallback end
assert(type(value) == "number" and value % 1 == 0 and value >= 1 and value <= 12,
key .. " must be an integer from 1 to 12")
return value
end
local minLevel, maxLevel = level("MinViciousLevel",1), level("MaxViciousLevel",12)
assert(minLevel <= maxLevel, "MinViciousLevel must not exceed MaxViciousLevel")
local dontHop = options.DontHop
if dontHop == nil then dontHop = false end
assert(type(dontHop)=="boolean", "DontHop must be true or false")
local viciousMovement = "Walk" -- fixed build
if viciousMovement == nil then viciousMovement = "Walk" end
assert(viciousMovement=="Walk" or viciousMovement=="Tween", "ViciousMovement must be Walk")
local useRedCannon=options.UseRedCannon
if useRedCannon==nil then useRedCannon=true end
assert(type(useRedCannon)=="boolean", "UseRedCannon must be true or false")
local speedEnabled=options.WalkSpeedEnabled
if speedEnabled==nil then speedEnabled=true end
assert(type(speedEnabled)=="boolean", "WalkSpeedEnabled must be true or false")
local walkingSpeed=options.WalkSpeed or 50
assert(type(walkingSpeed)=="number" and walkingSpeed==walkingSpeed and walkingSpeed>=1 and walkingSpeed<=100, "WalkSpeed must be from 1 to 100")
local tweenSpeed=options.TweenSpeed or 8
assert(type(tweenSpeed)=="number" and tweenSpeed==tweenSpeed and tweenSpeed>0 and tweenSpeed<math.huge, "TweenSpeed must be a positive finite number")
tweenSpeed=math.clamp(tweenSpeed,4,12)
local navigationInput, fireflyCollectStep, fireflyTravel
local mainAccount = options.MainAccount or ""
local group = options.Group or ""
assert(type(mainAccount)=="string", "MainAccount must be a Roblox username, or an empty string")
assert(type(group)=="string", "Group must be a shared room name, or an empty string")
mainAccount = mainAccount:match("^%s*(.-)%s*$")
group = group:match("^%s*(.-)%s*$")
local relayURL=options.RelayURL or "https://novahop-relay.lmgmeee.workers.dev"
assert(type(relayURL)=="string", "RelayURL must be an HTTP or HTTPS base URL")
relayURL=relayURL:match("^%s*(.-)%s*$"):gsub("/+$", "")
assert(relayURL:match("^https?://[^/%s?#]+[^%s?#]*$") and not relayURL:find("@",1,true), "RelayURL must be an HTTP or HTTPS base URL without credentials, query, or fragment")
local grouped = group ~= ""
assert(not grouped or mainAccount ~= "", "Set MainAccount when using a Group")
local isMain = grouped and player.Name:lower() == mainAccount:lower()
local UserConfig = {
minlvl=minLevel, maxlvl=maxLevel, donthop=dontHop, movement=viciousMovement, tweenmovement=viciousMovement=="Tween", tweenspeed=tweenSpeed,
relay=relayURL, room=grouped and group or "", main=isMain, alt=grouped and not isMain, cannon=useRedCannon,
walkspeedon=speedEnabled, walkspeed=walkingSpeed,  fastrare=false, usesprinkler=false, planters=false,
}
shared.TifaHop = {
MinViciousLevel=minLevel, MaxViciousLevel=maxLevel, DontHop=dontHop,
MainAccount=mainAccount, Group=group, RelayURL=relayURL,
ViciousMovement=viciousMovement, TweenSpeed=tweenSpeed,
UseRedCannon=useRedCannon, WalkSpeedEnabled=speedEnabled, WalkSpeed=walkingSpeed,
}
for key,value in pairs(UserConfig) do shared[key]=value end
shared.mainuser = grouped and mainAccount or ""
if writefile and makefolder and isfolder then
local ok, reason = pcall(function()
if not isfolder("TifaHop") then makefolder("TifaHop") end
writefile(configPath, http:JSONEncode(shared.TifaHop))
end)
if not ok then warn("[TifaHop] Could not save loader configuration: " .. tostring(reason)) end
end
local speedSettings
local speedCharacter, originalSpeed, lastWrittenSpeed
local function refreshWalkingSpeed()
local settings=speedSettings or UserConfig
settings.tweenmovement=false
if selectedFarm then settings.mode=selectedFarm end
local enabled=settings.walkspeedon==true
local value=math.clamp(tonumber(settings.walkspeed) or walkingSpeed,1,100)
local character=player.Character
local humanoid=character and character:FindFirstChildOfClass("Humanoid")
if humanoid and humanoid.Health>0 then
if speedCharacter~=humanoid then speedCharacter=humanoid; originalSpeed=humanoid.WalkSpeed; lastWrittenSpeed=nil end
if enabled then
local applied=settings.walkdynamic and math.min(value,originalSpeed*(tonumber(settings.walkmult) or 1.5)) or value
humanoid.WalkSpeed=applied; lastWrittenSpeed=applied
elseif lastWrittenSpeed then
if humanoid.WalkSpeed==lastWrittenSpeed then humanoid.WalkSpeed=originalSpeed end
lastWrittenSpeed=nil
else originalSpeed=humanoid.WalkSpeed end
end
useRedCannon=settings.cannon~=false
local movement=settings.tweenmovement and "Tween" or "Walk"
local tweenValue=math.clamp(tonumber(settings.tweenspeed) or tweenSpeed,4,12)
if shared.TifaHop.WalkSpeedEnabled~=enabled or shared.TifaHop.WalkSpeed~=value or shared.TifaHop.ViciousMovement~=movement or shared.TifaHop.TweenSpeed~=tweenValue or shared.TifaHop.UseRedCannon~=settings.cannon then
shared.TifaHop.ViciousMovement=movement; shared.TifaHop.TweenSpeed=tweenValue; shared.TifaHop.UseRedCannon=settings.cannon
UserConfig.tweenmovement=settings.tweenmovement; UserConfig.tweenspeed=tweenValue; UserConfig.cannon=settings.cannon
shared.TifaHop.WalkSpeedEnabled=enabled; shared.TifaHop.WalkSpeed=value
UserConfig.walkspeedon=enabled; UserConfig.walkspeed=value
shared.walkspeedon=enabled; shared.walkspeed=value
if writefile then pcall(function() writefile(configPath,http:JSONEncode(shared.TifaHop)) end) end
end
end
local function applyUserConfig(settings)
for key,value in pairs(UserConfig) do settings[key]=value end
if selectedFarm then settings.mode=selectedFarm end
speedSettings=settings
pcall(function()
if shared.TifaHopSpeedConnection then shared.TifaHopSpeedConnection:Disconnect() end
local elapsed=0
shared.TifaHopSpeedConnection=game:GetService("RunService").Heartbeat:Connect(function(dt)
elapsed+=dt
if elapsed>=0.25 then elapsed=0; refreshWalkingSpeed() end
end)
end)
end
local function rebrandString(value)
if type(value) ~= "string" then return value end
if value:find("https://novahop-relay.",1,true) then return value end
value=value:gsub("NovaHop","TifaHop"):gsub("novahop","tifahop"):gsub("NOVAHOP","TIFAHOP")
value=value:gsub("_nh","_th")
return value
end
